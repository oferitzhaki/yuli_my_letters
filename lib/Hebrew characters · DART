// Character definitions for Hebrew Alphabet Learning App

enum CharacterStage { baby, kid, adult }

class HebrewCharacter {
  final String id;
  final String letter; // Hebrew letter (א, ב, ג, etc.)
  final String name; // Hebrew name (אַרְיֵה, דּוּב, etc.)
  final String animal; // English animal name
  final String emoji; // Character emoji
  final String color; // Hex color for UI
  final String description; // Short description
  
  HebrewCharacter({
    required this.id,
    required this.letter,
    required this.name,
    required this.animal,
    required this.emoji,
    required this.color,
    required this.description,
  });
}

