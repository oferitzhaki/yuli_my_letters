// Get character by ID
HebrewCharacter? getCharacterById(String id) {
  try {
    return hebrewCharacters.firstWhere((char) => char.id == id);
  } catch (e) {
    return null;
  }
}

// Get character by letter
HebrewCharacter? getCharacterByLetter(String letter) {
  try {
    return hebrewCharacters.firstWhere((char) => char.letter == letter);
  } catch (e) {
    return null;
  }
}

// Get all characters in a specific stage (by index/difficulty)
List<HebrewCharacter> getCharactersByLevel(int level) {
  // Level 1: First 5 characters (easy)
  // Level 2: Characters 6-11 (medium)
  // Level 3: Characters 12-17 (harder)
  // Level 4: Characters 18-22 (hardest)
  
  int startIndex = (level - 1) * 5;
  int endIndex = (startIndex + 5).clamp(0, hebrewCharacters.length);
  return hebrewCharacters.sublist(startIndex, endIndex);
}