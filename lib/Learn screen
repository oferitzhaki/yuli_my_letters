import 'package:flutter/material.dart';
import '../constants/hebrew_characters.dart';

class LearnScreen extends StatefulWidget {
  const LearnScreen({Key? key}) : super(key: key);

  @override
  State<LearnScreen> createState() => _LearnScreenState();
}

class _LearnScreenState extends State<LearnScreen> {
  int currentIndex = 0;
  int score = 0;
  int correctAnswers = 0;
  late HebrewCharacter currentCharacter;
  late List<HebrewCharacter> options;
  bool isAnswered = false;
  bool isCorrect = false;

  @override
  void initState() {
    super.initState();
    _setupGame();
  }

  void _setupGame() {
    currentCharacter = hebrewAlphabet[currentIndex];
    // Create 4 options: correct answer + 3 random others
    options = [currentCharacter];
    
    final otherCharacters = hebrewAlphabet
        .where((c) => c != currentCharacter)
        .toList();
    otherCharacters.shuffle();
    options.addAll(otherCharacters.take(3));
    
    options.shuffle();
    isAnswered = false;
    isCorrect = false;
  }

  void _onAnswerSelected(HebrewCharacter selected) {
    setState(() {
      isAnswered = true;
      isCorrect = selected == currentCharacter;
    });

    if (isCorrect) {
      setState(() {
        score += 5;
        correctAnswers++;
      });
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('✅ כל הכבוד! נכון!'),
          duration: Duration(milliseconds: 800),
          backgroundColor: Colors.green,
        ),
      );

      Future.delayed(const Duration(seconds: 1), () {
        if (mounted) {
          setState(() {
            currentIndex++;
            if (currentIndex < hebrewAlphabet.length) {
              _setupGame();
            } else {
              _showGameOver();
            }
          });
        }
      });
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('❌ נסה שוב! זה לא נכון'),
          duration: Duration(milliseconds: 800),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  void _showGameOver() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (_) => AlertDialog(
        title: const Text(
          '🎊 סיים!',
          textAlign: TextAlign.center,
          style: TextStyle(fontSize: 28),
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              'מעולה יוליה!',
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
                color: Colors.deepOrange,
              ),
            ),
            const SizedBox(height: 20),
            Text(
              'ניחשת נכון: $correctAnswers מתוך ${hebrewAlphabet.length}',
              style: const TextStyle(fontSize: 18),
              textAlign: TextAlign.center,
            ),
            const SizedBox(height: 10),
            Text(
              'נקודות: $score ⭐',
              style: const TextStyle(
                fontSize: 24,
                fontWeight: FontWeight.bold,
                color: Colors.amber,
              ),
              textAlign: TextAlign.center,
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(context); // Close dialog
              Navigator.pop(context); // Go back to home
            },
            child: const Text('חזור הביתה 🏠'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(
          'שאלה ${currentIndex + 1}/${hebrewAlphabet.length}',
          style: const TextStyle(fontSize: 18),
        ),
        backgroundColor: Colors.deepOrange,
        elevation: 0,
      ),
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [Color(0xFFFFE0B2), Color(0xFFFFCC80)],
          ),
        ),
        child: Center(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(20),
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                // Score bar
                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 20,
                    vertical: 10,
                  ),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(20),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withOpacity(0.1),
                        blurRadius: 5,
                      ),
                    ],
                  ),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceAround,
                    children: [
                      Column(
                        children: [
                          const Text(
                            '⭐ Points',
                            style: TextStyle(fontSize: 12, color: Colors.grey),
                          ),
                          Text(
                            '$score',
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                              color: Colors.amber,
                            ),
                          ),
                        ],
                      ),
                      Column(
                        children: [
                          const Text(
                            '✅ Correct',
                            style: TextStyle(fontSize: 12, color: Colors.grey),
                          ),
                          Text(
                            '$correctAnswers',
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                              color: Colors.green,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 40),

                // Big emoji of the animal
                Container(
                  padding: const EdgeInsets.all(30),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(30),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withOpacity(0.2),
                        blurRadius: 10,
                      ),
                    ],
                  ),
                  child: Text(
                    currentCharacter.emoji,
                    style: const TextStyle(fontSize: 120),
                  ),
                ),
                const SizedBox(height: 30),

                // Question text
                Text(
                  'איזו אות זו?',
                  style: const TextStyle(
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                    color: Colors.black87,
                  ),
                ),
                const SizedBox(height: 10),
                Text(
                  currentCharacter.hebrewLetter,
                  style: const TextStyle(
                    fontSize: 48,
                    fontWeight: FontWeight.bold,
                    color: Colors.deepOrange,
                  ),
                ),
                const SizedBox(height: 50),

                // Answer buttons (4 options)
                ...options.map((option) {
                  bool selectedThisOption = isAnswered &&
                      (option == currentCharacter ||
                          option == currentCharacter); // Will fix with proper state
                  
                  return Padding(
                    padding: const EdgeInsets.symmetric(vertical: 10),
                    child: SizedBox(
                      width: double.infinity,
                      child: ElevatedButton(
                        onPressed: isAnswered
                            ? null
                            : () => _onAnswerSelected(option),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: isAnswered
                              ? (option == currentCharacter
                                  ? Colors.green
                                  : Colors.grey.shade300)
                              : Colors.lightBlue,
                          disabledBackgroundColor: isAnswered
                              ? (option == currentCharacter
                                  ? Colors.green
                                  : Colors.grey.shade300)
                              : Colors.lightBlue,
                          padding: const EdgeInsets.symmetric(vertical: 18),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(15),
                          ),
                          elevation: 5,
                        ),
                        child: Text(
                          '${option.emoji} ${option.animalName}',
                          style: TextStyle(
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                            color: isAnswered && option != currentCharacter
                                ? Colors.grey
                                : Colors.black87,
                          ),
                        ),
                      ),
                    ),
                  );
                }).toList(),

                if (isAnswered && !isCorrect)
                  Padding(
                    padding: const EdgeInsets.only(top: 20),
                    child: ElevatedButton(
                      onPressed: () {
                        setState(() {
                          currentIndex++;
                          if (currentIndex < hebrewAlphabet.length) {
                            _setupGame();
                          } else {
                            _showGameOver();
                          }
                        });
                      },
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.blue,
                        padding: const EdgeInsets.symmetric(
                          horizontal: 30,
                          vertical: 12,
                        ),
                      ),
                      child: const Text(
                        'שאלה הבאה →',
                        style: TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}